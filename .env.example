# MoodTrack Pro - .env.example

# ==== Backend (./backend) ====
MONGO_URI=mongodb://localhost:27017/moodtrack
JWT_SECRET=replace_this_with_a_long_secret
OPENAI_API_KEY=your_openai_key_here
PORT=5000

# Third-party OAuth (if using Auth0)
AUTH0_DOMAIN=your-auth0-domain
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Firebase for frontend
REACT_APP_FIREBASE_API_KEY=your_firebase_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_firebase_domain
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id

# Cloud backup / storage
CLOUD_BACKUP_URL=https://example.com/cloud-backup-api

# Google Calendar/Outlook API (premium)
GOOGLE_CALENDAR_API_KEY=your-google-calendar-key
OUTLOOK_API_KEY=your-outlook-key

# ==== Frontend (./emospense_pro_frontend) ====
# (Use REACT_APP_ prefix for all CRA env variables)
REACT_APP_API_URL=http://localhost:5000

